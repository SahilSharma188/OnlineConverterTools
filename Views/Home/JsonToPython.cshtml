@{
    ViewData["Title"] = "JSON to Python";
}

<div class="container">
    <h2 class="mb-4">JSON to Python Class Converter</h2>
    
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="jsonInput" class="form-label">JSON Input</label>
                    <textarea class="form-control" id="jsonInput" rows="15" placeholder="Paste your JSON here..."></textarea>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="pythonOutput" class="form-label">Python Output</label>
                    <textarea class="form-control" id="pythonOutput" rows="15" readonly></textarea>
                </div>
            </div>
            
            <div class="d-flex gap-2 mb-3">
                <button onclick="convertToPython()" class="btn btn-primary">Convert to Python</button>
                <button onclick="clearInputs()" class="btn btn-outline-danger">Clear</button>
                <button onclick="copyToClipboard()" class="btn btn-outline-secondary">Copy Python Code</button>
            </div>

            <div class="alert alert-danger d-none" id="error"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @{
            var jsCode = @"
                function convertToPython() {
                    try {
                        const jsonInput = document.getElementById('jsonInput').value;
                        if (!jsonInput) {
                            throw new Error('Please enter JSON to convert');
                        }

                        const json = JSON.parse(jsonInput);
                        const pythonCode = generatePythonClass(json);
                        document.getElementById('pythonOutput').value = pythonCode;
                        document.getElementById('error').classList.add('d-none');
                    } catch (e) {
                        showError(e.message);
                    }
                }

                function generatePythonClass(json, className = 'RootObject') {
                    let code = `from dataclasses import dataclass\nfrom typing import List, Optional, Any\n\n`;
                    code += `@dataclass\n`;
                    code += `class ${className}:\n`;
                    
                    for (const [key, value] of Object.entries(json)) {
                        const fieldName = key;
                        const fieldType = getPythonType(value);
                        code += `    ${fieldName}: ${fieldType}\n`;
                    }
                    
                    return code;
                }

                function getPythonType(value) {
                    if (value === null) return 'Optional[Any]';
                    if (Array.isArray(value)) {
                        if (value.length === 0) return 'List[Any]';
                        return `List[${getPythonType(value[0])}]`;
                    }
                    if (typeof value === 'object') return 'dict';
                    if (typeof value === 'string') return 'str';
                    if (typeof value === 'number') {
                        return Number.isInteger(value) ? 'int' : 'float';
                    }
                    if (typeof value === 'boolean') return 'bool';
                    return 'Any';
                }

                function clearInputs() {
                    document.getElementById('jsonInput').value = '';
                    document.getElementById('pythonOutput').value = '';
                    document.getElementById('error').classList.add('d-none');
                }

                function copyToClipboard() {
                    const output = document.getElementById('pythonOutput');
                    output.select();
                    document.execCommand('copy');
                    alert('Python code copied to clipboard!');
                }

                function showError(message) {
                    document.getElementById('error').textContent = message;
                    document.getElementById('error').classList.remove('d-none');
                }
            ";
        }
        @Html.Raw(jsCode)
    </script>
} 