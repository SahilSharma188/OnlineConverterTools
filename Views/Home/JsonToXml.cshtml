@{
    ViewData["Title"] = "JSON to XML";
}

<div class="container">
    <h2 class="mb-4">JSON to XML Converter</h2>
    
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="jsonInput" class="form-label">JSON Input</label>
                    <textarea class="form-control" id="jsonInput" rows="15" placeholder="Paste your JSON here..."></textarea>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="xmlOutput" class="form-label">XML Output</label>
                    <textarea class="form-control" id="xmlOutput" rows="15" readonly></textarea>
                </div>
            </div>
            
            <div class="d-flex gap-2 mb-3">
                <button onclick="convertToXml()" class="btn btn-primary">Convert to XML</button>
                <button onclick="clearInputs()" class="btn btn-outline-danger">Clear</button>
                <button onclick="copyToClipboard()" class="btn btn-outline-secondary">Copy XML</button>
            </div>

            <div class="alert alert-danger d-none" id="error"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function convertToXml() {
            try {
                const jsonInput = document.getElementById('jsonInput').value;
                if (!jsonInput) {
                    throw new Error('Please enter JSON to convert');
                }

                const json = JSON.parse(jsonInput);
                const xml = jsonToXml(json);
                document.getElementById('xmlOutput').value = xml;
                document.getElementById('error').classList.add('d-none');
            } catch (e) {
                showError(e.message);
            }
        }

        function jsonToXml(obj, rootName = 'root') {
            let xml = `<?xml version="1.0" encoding="UTF-8"?>\n<${rootName}>\n`;
            
            for (const [key, value] of Object.entries(obj)) {
                if (value === null) {
                    xml += `  <${key} />\n`;
                } else if (typeof value === 'object') {
                    if (Array.isArray(value)) {
                        value.forEach(item => {
                            xml += `  <${key}>\n`;
                            if (typeof item === 'object') {
                                xml += jsonToXml(item, key).split('\n').slice(1, -1).map(line => '    ' + line).join('\n') + '\n';
                            } else {
                                xml += `    ${item}\n`;
                            }
                            xml += `  </${key}>\n`;
                        });
                    } else {
                        xml += `  <${key}>\n`;
                        xml += jsonToXml(value, key).split('\n').slice(1, -1).map(line => '    ' + line).join('\n') + '\n';
                        xml += `  </${key}>\n`;
                    }
                } else {
                    xml += `  <${key}>${value}</${key}>\n`;
                }
            }
            
            xml += `</${rootName}>`;
            return xml;
        }

        function clearInputs() {
            document.getElementById('jsonInput').value = '';
            document.getElementById('xmlOutput').value = '';
            document.getElementById('error').classList.add('d-none');
        }

        function copyToClipboard() {
            const output = document.getElementById('xmlOutput');
            output.select();
            document.execCommand('copy');
            alert('XML copied to clipboard!');
        }

        function showError(message) {
            document.getElementById('error').textContent = message;
            document.getElementById('error').classList.remove('d-none');
        }
    </script>
} 