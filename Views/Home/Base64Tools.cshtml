@{
    ViewData["Title"] = "Base64 Tools";
}

<div class="container">
    <h2 class="mb-4">Base64 Tools</h2>
    
    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label for="input" class="form-label">Input</label>
                <textarea class="form-control" id="input" rows="5" placeholder="Enter text to encode or Base64 to decode..."></textarea>
            </div>
            
            <div class="d-flex gap-2 mb-3">
                <button onclick="encodeBase64()" class="btn btn-primary">Encode</button>
                <button onclick="decodeBase64()" class="btn btn-secondary">Decode</button>
                <button onclick="clearInput()" class="btn btn-outline-danger">Clear</button>
            </div>

            <div class="alert alert-danger d-none" id="error"></div>

            <div class="mt-4" id="result" style="display: none;">
                <h4>Result</h4>
                <div class="card bg-light">
                    <div class="card-body">
                        <pre class="mb-0" id="resultText"></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function encodeBase64() {
            try {
                const input = document.getElementById('input').value;
                if (!input) {
                    throw new Error('Please enter text to encode');
                }
                const encoded = btoa(input);
                showResult(encoded);
                document.getElementById('error').classList.add('d-none');
            } catch (e) {
                showError(e.message);
            }
        }

        function decodeBase64() {
            try {
                const input = document.getElementById('input').value;
                if (!input) {
                    throw new Error('Please enter Base64 to decode');
                }
                const decoded = atob(input);
                showResult(decoded);
                document.getElementById('error').classList.add('d-none');
            } catch (e) {
                showError('Invalid Base64 string');
            }
        }

        function clearInput() {
            document.getElementById('input').value = '';
            document.getElementById('result').style.display = 'none';
            document.getElementById('error').classList.add('d-none');
        }

        function showResult(text) {
            document.getElementById('resultText').textContent = text;
            document.getElementById('result').style.display = 'block';
        }

        function showError(message) {
            document.getElementById('error').textContent = message;
            document.getElementById('error').classList.remove('d-none');
            document.getElementById('result').style.display = 'none';
        }
    </script>
} 