@{
    ViewData["Title"] = "JSON to C#";
}

<div class="container">
    <h2 class="mb-4">JSON to C# Class Converter</h2>
    
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="jsonInput" class="form-label">JSON Input</label>
                    <textarea class="form-control" id="jsonInput" rows="15" placeholder="Paste your JSON here..."></textarea>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="csharpOutput" class="form-label">C# Output</label>
                    <textarea class="form-control" id="csharpOutput" rows="15" readonly></textarea>
                </div>
            </div>
            
            <div class="d-flex gap-2 mb-3">
                <button onclick="convertToCSharp()" class="btn btn-primary">Convert to C#</button>
                <button onclick="clearInputs()" class="btn btn-outline-danger">Clear</button>
                <button onclick="copyToClipboard()" class="btn btn-outline-secondary">Copy C# Code</button>
            </div>

            <div class="alert alert-danger d-none" id="error"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function convertToCSharp() {
            try {
                const jsonInput = document.getElementById('jsonInput').value;
                if (!jsonInput) {
                    throw new Error('Please enter JSON to convert');
                }

                const json = JSON.parse(jsonInput);
                const csharpCode = generateCSharpClass(json);
                document.getElementById('csharpOutput').value = csharpCode;
                document.getElementById('error').classList.add('d-none');
            } catch (e) {
                showError(e.message);
            }
        }

        function generateCSharpClass(json, className = 'RootObject') {
            let code = `public class ${className}\n{\n`;
            
            for (const [key, value] of Object.entries(json)) {
                const propertyName = key.charAt(0).toUpperCase() + key.slice(1);
                const propertyType = getCSharpType(value);
                code += `    public ${propertyType} ${propertyName} { get; set; }\n`;
            }
            
            code += '}';
            return code;
        }

        function getCSharpType(value) {
            if (value === null) return 'object';
            if (Array.isArray(value)) {
                if (value.length === 0) return 'List<object>';
                return `List<${getCSharpType(value[0])}>`;
            }
            if (typeof value === 'object') return 'object';
            if (typeof value === 'string') return 'string';
            if (typeof value === 'number') {
                return Number.isInteger(value) ? 'int' : 'double';
            }
            if (typeof value === 'boolean') return 'bool';
            return 'object';
        }

        function clearInputs() {
            document.getElementById('jsonInput').value = '';
            document.getElementById('csharpOutput').value = '';
            document.getElementById('error').classList.add('d-none');
        }

        function copyToClipboard() {
            const output = document.getElementById('csharpOutput');
            output.select();
            document.execCommand('copy');
            alert('C# code copied to clipboard!');
        }

        function showError(message) {
            document.getElementById('error').textContent = message;
            document.getElementById('error').classList.remove('d-none');
        }
    </script>
} 