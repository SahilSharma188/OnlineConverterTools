@{
    ViewData["Title"] = "JSON Tools";
}

<div class="container">
    <h2 class="mb-4">JSON Tools</h2>
    
    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label for="jsonInput" class="form-label">Input JSON</label>
                <textarea class="form-control" id="jsonInput" rows="10" placeholder="Paste your JSON here..."></textarea>
            </div>
            
            <div class="d-flex gap-2 mb-3">
                <button onclick="beautifyJson()" class="btn btn-primary">Beautify</button>
                <button onclick="minifyJson()" class="btn btn-secondary">Minify</button>
                <button onclick="clearJson()" class="btn btn-outline-danger">Clear</button>
            </div>

            <div class="alert alert-danger d-none" id="jsonError"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function beautifyJson() {
            try {
                const input = document.getElementById('jsonInput').value;
                const obj = JSON.parse(input);
                document.getElementById('jsonInput').value = JSON.stringify(obj, null, 2);
                document.getElementById('jsonError').classList.add('d-none');
            } catch (e) {
                document.getElementById('jsonError').textContent = 'Invalid JSON: ' + e.message;
                document.getElementById('jsonError').classList.remove('d-none');
            }
        }

        function minifyJson() {
            try {
                const input = document.getElementById('jsonInput').value;
                const obj = JSON.parse(input);
                document.getElementById('jsonInput').value = JSON.stringify(obj);
                document.getElementById('jsonError').classList.add('d-none');
            } catch (e) {
                document.getElementById('jsonError').textContent = 'Invalid JSON: ' + e.message;
                document.getElementById('jsonError').classList.remove('d-none');
            }
        }

        function clearJson() {
            document.getElementById('jsonInput').value = '';
            document.getElementById('jsonError').classList.add('d-none');
        }
    </script>
} 