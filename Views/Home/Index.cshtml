@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Simple Online Tools</h1>
    <p class="lead">A collection of useful online tools for everyday tasks</p>
</div>

<div class="row mt-4">
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">JSON Tools</h5>
                <p class="card-text">Beautify and minify your JSON data with ease.</p>
                <a asp-controller="Home" asp-action="JsonTools" class="btn btn-primary">Use Tool</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Text Compare</h5>
                <p class="card-text">Compare two texts and see the differences.</p>
                <a asp-controller="Home" asp-action="TextCompare" class="btn btn-primary">Use Tool</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Age Calculator</h5>
                <p class="card-text">Calculate age in years, months, and days.</p>
                <a asp-controller="Home" asp-action="AgeCalculator" class="btn btn-primary">Use Tool</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">BMI Calculator</h5>
                <p class="card-text">Calculate your Body Mass Index and category.</p>
                <a asp-controller="Home" asp-action="BmiCalculator" class="btn btn-primary">Use Tool</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Unit Converter</h5>
                <p class="card-text">Convert between different units of measurement.</p>
                <a asp-controller="Home" asp-action="UnitConverter" class="btn btn-primary">Use Tool</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Base64 Tools</h5>
                <p class="card-text">Encode and decode Base64 strings.</p>
                <a asp-controller="Home" asp-action="Base64Tools" class="btn btn-primary">Use Tool</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Lorem Ipsum Generator</h5>
                <p class="card-text">Generate placeholder text for your designs.</p>
                <a asp-controller="Home" asp-action="LoremIpsum" class="btn btn-primary">Use Tool</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Word Counter</h5>
                <p class="card-text">Count words and characters in your text.</p>
                <a asp-controller="Home" asp-action="WordCounter" class="btn btn-primary">Use Tool</a>
            </div>
        </div>
    </div>
</div>
