@{
    ViewData["Title"] = "BMI Calculator";
}

<div class="container">
    <h2 class="mb-4">BMI Calculator</h2>
    
    <div class="card">
        <div class="card-body">
            <form id="bmiForm" class="needs-validation" novalidate>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="weight" class="form-label">Weight (kg)</label>
                        <input type="number" class="form-control" id="weight" required min="1" step="0.1">
                        <div class="invalid-feedback">
                            Please enter a valid weight.
                        </div>
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <label for="height" class="form-label">Height (cm)</label>
                        <input type="number" class="form-control" id="height" required min="1" step="0.1">
                        <div class="invalid-feedback">
                            Please enter a valid height.
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Calculate BMI</button>
            </form>

            <div class="mt-4" id="bmiResult" style="display: none;">
                <h4>Your Results</h4>
                <div class="card bg-light">
                    <div class="card-body">
                        <p class="mb-1">BMI: <span id="bmiValue"></span></p>
                        <p class="mb-1">Category: <span id="bmiCategory"></span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('bmiForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const weight = parseFloat(document.getElementById('weight').value);
            const height = parseFloat(document.getElementById('height').value) / 100; // convert cm to m
            
            if (weight && height) {
                const bmi = weight / (height * height);
                let category = '';
                
                if (bmi < 18.5) category = 'Underweight';
                else if (bmi < 25) category = 'Normal weight';
                else if (bmi < 30) category = 'Overweight';
                else category = 'Obese';
                
                document.getElementById('bmiValue').textContent = bmi.toFixed(1);
                document.getElementById('bmiCategory').textContent = category;
                document.getElementById('bmiResult').style.display = 'block';
            }
        });
    </script>
} 