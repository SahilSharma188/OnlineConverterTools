@{
    ViewData["Title"] = "Text Compare";
}

<div class="container">
    <h2 class="mb-4">Text Compare</h2>
    
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="text1" class="form-label">Text 1</label>
                    <textarea class="form-control" id="text1" rows="10" placeholder="Enter first text..."></textarea>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="text2" class="form-label">Text 2</label>
                    <textarea class="form-control" id="text2" rows="10" placeholder="Enter second text..."></textarea>
                </div>
            </div>
            
            <div class="d-flex gap-2 mb-3">
                <button onclick="compareTexts()" class="btn btn-primary">Compare</button>
                <button onclick="clearTexts()" class="btn btn-outline-danger">Clear</button>
            </div>

            <div id="comparisonResult" class="mt-4" style="display: none;">
                <h4>Comparison Result</h4>
                <div class="card bg-light">
                    <div class="card-body">
                        <p class="mb-1">Differences found: <span id="diffCount">0</span></p>
                        <div id="diffDetails" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function compareTexts() {
            const text1 = document.getElementById('text1').value;
            const text2 = document.getElementById('text2').value;
            
            if (!text1 || !text2) {
                alert('Please enter both texts to compare');
                return;
            }

            const lines1 = text1.split('\n');
            const lines2 = text2.split('\n');
            let diffCount = 0;
            let diffDetails = '';

            for (let i = 0; i < Math.max(lines1.length, lines2.length); i++) {
                if (lines1[i] !== lines2[i]) {
                    diffCount++;
                    diffDetails += `<div class="mb-2">
                        <strong>Line ${i + 1}:</strong><br>
                        <span class="text-danger">- ${lines1[i] || '(empty)'}</span><br>
                        <span class="text-success">+ ${lines2[i] || '(empty)'}</span>
                    </div>`;
                }
            }

            document.getElementById('diffCount').textContent = diffCount;
            document.getElementById('diffDetails').innerHTML = diffDetails;
            document.getElementById('comparisonResult').style.display = 'block';
        }

        function clearTexts() {
            document.getElementById('text1').value = '';
            document.getElementById('text2').value = '';
            document.getElementById('comparisonResult').style.display = 'none';
        }
    </script>
} 